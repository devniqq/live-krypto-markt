/* ---------- helpers ---------- */
const nf = (v,d=2)=> v==null||isNaN(v) ? "—" : Number(v).toLocaleString("de-DE",{minimumFractionDigits:d,maximumFractionDigits:d});
function fmtPrice(v){
  if(v==null||isNaN(v)) return "—";
  if(v>=1000) return nf(v,0);
  if(v>=1) return nf(v,2);
  if(v>=0.01) return nf(v,4);
  return nf(v,6);
}
function fmtCap(v){
  if(v==null||isNaN(v)) return "—";
  if(v>=1e12) return nf(v/1e12,2)+" Bio. $";
  if(v>=1e9) return nf(v/1e9,2)+" Mrd. $";
  if(v>=1e6) return nf(v/1e6,1)+" Mio. $";
  return nf(v,0)+" $";
}
function pct(v){ return v==null||isNaN(v) ? "—" : (v>0?"+":"")+nf(v,2)+" %"; }
function cls(v){ return v==null||isNaN(v) ? "fl" : (v>0?"up":(v<0?"dn":"fl")); }
function esc(s){ return String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }

function sparkline(vals,w,h,color){
  if(!vals||vals.length<2) return "";
  const min=Math.min.apply(null,vals), max=Math.max.apply(null,vals), rng=(max-min)||1;
  const pts=vals.map((v,i)=>[i/(vals.length-1)*w, h-((v-min)/rng)*(h-6)-3]);
  const d=pts.map((p,i)=>(i?"L":"M")+p[0].toFixed(1)+" "+p[1].toFixed(1)).join(" ");
  return '<svg viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none" class="spark">'+
    '<path d="'+d+' L '+w+' '+h+' L 0 '+h+' Z" fill="'+color+'" opacity="0.13"/>'+
    '<path d="'+d+'" fill="none" stroke="'+color+'" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/></svg>';
}
function miniSpark(vals,color){
  if(!vals||vals.length<2) return "";
  const w=56,h=20,min=Math.min.apply(null,vals),max=Math.max.apply(null,vals),rng=(max-min)||1;
  const pts=vals.map((v,i)=>[i/(vals.length-1)*w, h-((v-min)/rng)*(h-4)-2]);
  const d=pts.map((p,i)=>(i?"L":"M")+p[0].toFixed(1)+" "+p[1].toFixed(1)).join(" ");
  return '<svg viewBox="0 0 '+w+' '+h+'" class="mini"><path d="'+d+'" fill="none" stroke="'+color+'" stroke-width="1.5"/></svg>';
}
function bigChart(series,color,range){
  if(!series||series.length<2) return '<div style="padding:40px;text-align:center;color:var(--mut2)">Keine Verlaufsdaten verfügbar</div>';
  const W=760,H=230,PL=54,PR=14,PT=14,PB=26;
  const vals=series.map(s=>s[1]);
  let min=Math.min.apply(null,vals), max=Math.max.apply(null,vals);
  const pad=(max-min)*0.08||1; min-=pad; max+=pad;
  const iw=W-PL-PR, ih=H-PT-PB;
  const X=i=>PL+i/(series.length-1)*iw, Y=v=>PT+ih-((v-min)/(max-min))*ih;
  let d="",area="";
  series.forEach((s,i)=>{ const x=X(i).toFixed(1),y=Y(s[1]).toFixed(1); d+=(i?"L":"M")+x+" "+y+" "; });
  area=d+"L "+(PL+iw)+" "+(PT+ih)+" L "+PL+" "+(PT+ih)+" Z";
  let grid="",labels="";
  for(let g=0;g<=4;g++){
    const v=min+(max-min)*g/4, y=Y(v).toFixed(1);
    grid+='<line x1="'+PL+'" y1="'+y+'" x2="'+(PL+iw)+'" y2="'+y+'" stroke="#1e2a36" stroke-width="1"/>';
    labels+='<text x="'+(PL-8)+'" y="'+(+y+4)+'" fill="#5f7183" font-size="10.5" text-anchor="end">'+fmtPrice(v)+'</text>';
  }
  const n=series.length;
  const axFmt = (range==="1J") ? {month:"short",year:"2-digit"} : {day:"2-digit",month:"2-digit"};
  [0,Math.floor(n/2),n-1].forEach(i=>{
    const dt=new Date(series[i][0]);
    const lbl=dt.toLocaleDateString("de-DE",axFmt);
    labels+='<text x="'+X(i).toFixed(1)+'" y="'+(H-8)+'" fill="#5f7183" font-size="10.5" text-anchor="middle">'+lbl+'</text>';
  });
  return '<svg viewBox="0 0 '+W+' '+H+'" class="chart" preserveAspectRatio="none">'+grid+
    '<path d="'+area+'" fill="'+color+'" opacity="0.10"/>'+
    '<path d="'+d+'" fill="none" stroke="'+color+'" stroke-width="2" stroke-linejoin="round"/>'+labels+'</svg>';
}

