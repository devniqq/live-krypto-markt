    '<span class="tag '+x.cat+'">'+CATLBL[x.cat]+'</span>'+
    '<div class="hd"><div class="tk"><div class="ic" style="background:'+x.color+'">'+esc(x.ticker.slice(0,4))+'</div>'+
    '<div><div class="nm">'+esc(x.name)+'</div><div class="sy">'+esc(x.ticker)+'</div></div></div>'+
    '<div class="px"><div class="p">'+fmtPrice(x.price)+'</div>'+
    '<div class="c '+cls(x.ch24)+'">'+pct(x.ch24)+'</div></div></div>'+
    sp+
    '<div class="metrics">'+
      '<div><div class="mk">1 W</div><div class="mv '+cls(x.ch7)+'">'+pct(x.ch7)+'</div></div>'+
      '<div><div class="mk">1 M</div><div class="mv '+cls(x.ch30)+'">'+pct(x.ch30)+'</div></div>'+
      '<div><div class="mk">YTD</div><div class="mv '+cls(x.chYtd)+'">'+pct(x.chYtd)+'</div></div>'+
    '</div></div>';
}

function rowHTML(x){
  const sp=x.spark?miniSpark(x.spark,x.color):(x.series?miniSpark(x.series.slice(-60).map(s=>s[1]),x.color):"");
  return '<tr onclick="openModal(\''+x.id+'\')" style="cursor:pointer">'+
    '<td><b>'+esc(x.name)+'</b> <span style="color:var(--mut2);font-size:12px">'+esc(x.ticker)+'</span></td>'+
    '<td class="num">'+fmtPrice(x.price)+'</td>'+
    '<td class="num '+cls(x.ch24)+'">'+pct(x.ch24)+'</td>'+
    '<td class="num '+cls(x.ch7)+'">'+pct(x.ch7)+'</td>'+
    '<td class="num '+cls(x.ch30)+'">'+pct(x.ch30)+'</td>'+
    '<td class="num '+cls(x.chYtd)+'">'+pct(x.chYtd)+'</td>'+
    '<td class="num">'+fmtCap(x.mcap)+'</td>'+
    '<td>'+sp+'</td></tr>';
}

function renderKPIs(){
  const a=state.assets;
  const krypto=a.filter(x=>x.cat==="krypto");
  const up=krypto.filter(x=>x.ch24>0).length;
  const ytdUp=a.filter(x=>x.chYtd!=null&&x.chYtd>0).length;
  const best=a.slice().filter(x=>x.chYtd!=null).sort((p,q)=>q.chYtd-p.chYtd)[0];
  const worst=a.slice().filter(x=>x.chYtd!=null).sort((p,q)=>p.chYtd-q.chYtd)[0];
  const totalCap=krypto.reduce((s,x)=>s+(x.mcap||0),0);
  const k=[
    {k:"Krypto-Marktkap. (10)",v:fmtCap(totalCap),d:"Summe der beobachteten Assets"},
    {k:"Krypto im Plus (24 h)",v:up+" / "+krypto.length,d:"Tagesbewegung"},
    {k:"Assets mit positivem YTD",v:ytdUp+" / "+a.length,d:"seit 31.12.2025"},
    {k:"Bester YTD",v:best?best.ticker:"—",d:best?pct(best.chYtd):"",c:best?"up":""},
    {k:"Schwächster YTD",v:worst?worst.ticker:"—",d:worst?pct(worst.chYtd):"",c:worst?"dn":""}
  ];
  document.getElementById("kpis").innerHTML=k.map(x=>
    '<div class="kpi"><div class="k">'+x.k+'</div><div class="v '+(x.c||"")+'">'+x.v+'</div>'+
    '<div class="d '+(x.c||"")+'">'+x.d+'</div></div>').join("");
}

/* ---------- modal ---------- */
let modalRange="1J";
function openModal(id){
  const x=state.assets.find(a=>a.id===id); if(!x) return;
  modalRange="1J";
  document.getElementById("sheet").innerHTML=sheetHTML(x);
  document.getElementById("modal").classList.add("open");
  document.body.style.overflow="hidden";
}
function closeModal(){
  document.getElementById("modal").classList.remove("open");
  document.body.style.overflow="";
}
function setRange(r,id){ modalRange=r; const x=state.assets.find(a=>a.id===id); if(x) document.getElementById("sheet").innerHTML=sheetHTML(x); }
function seriesFor(x,r){
  if(r==="7T") return x.spark?x.spark.map((v,i)=>[Date.now()-(x.spark.length-1-i)*3600000,v]):null;
  if(!x.series) return null;
  if(r==="1M") return x.series.slice(-16);
  if(r==="3M") return x.series.slice(-46);
  return x.series;
}
function sheetHTML(x){
  const s=seriesFor(x,modalRange);
  const chg = modalRange==="7T"?x.ch7:(modalRange==="1M"?x.ch30:x.ch1y);
  const rows=[
    ["Marktkap.",fmtCap(x.mcap)],
    ["24 h",pct(x.ch24)],
    ["1 Woche",pct(x.ch7)],
    ["1 Monat",pct(x.ch30)],
    ["1 Jahr",pct(x.ch1y)],
    ["YTD (seit 31.12.25)",pct(x.chYtd)],
    ["Volumen 24 h",x.vol?fmtCap(x.vol):"—"],
    ["Allzeithoch",x.ath?fmtPrice(x.ath):"—"],
    ["Abstand zum ATH",x.athCh!=null?pct(x.athCh):"—"],
    ["Umlaufmenge",x.circ?nf(x.circ,0):"—"],
    ["Max. Menge",x.max?nf(x.max,0):"—"],
    ["Datenquelle",x.src]
  ];
  return '<button class="x" onclick="closeModal()">×</button>'+
    '<div class="sh"><div class="ic" style="background:'+x.color+';width:44px;height:44px;font-size:13px">'+esc(x.ticker.slice(0,4))+'</div>'+
    '<div><h3>'+esc(x.name)+'</h3><div class="sy">'+esc(x.ticker)+' · '+CATLBL[x.cat]+'</div></div></div>'+
    '<div class="big">'+fmtPrice(x.price)+' <span style="font-size:17px" class="'+cls(x.ch24)+'">'+pct(x.ch24)+'</span></div>'+
    '<div class="ranges">'+
      ["7T","1M","3M","1J"].map(r=>'<button class="'+(r===modalRange?"act":"")+'" onclick="setRange(\''+r+'\',\''+x.id+'\')">'+r+'</button>').join("")+
    '</div>'+
    bigChart(s,x.color,modalRange)+
    '<div class="dgrid">'+rows.map(r=>'<div class="d"><div class="dk">'+r[0]+'</div><div class="dv">'+r[1]+'</div></div>').join("")+'</div>'+
    '<div class="src">Kursdaten: '+x.src+(x.qtime?' · Quellen-Zeitstempel: '+x.qtime:'')+
    ' · Snapshot-Stand: '+SNAPSHOT.generated+' UTC</div>';
}

/* ---------- live ---------- */
function setStatus(mode,txt){
  const b=document.getElementById("status");
  b.className="badge "+(mode==="on"?"on":(mode==="err"?"err":"off"));
  document.getElementById("statusTxt").textContent=txt;
}
function stampNow(){
  const d=new Date();
  document.getElementById("stamp").textContent="Letzte Aktualisierung: "+
    d.toLocaleString("de-DE",{day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit",second:"2-digit"})+" Uhr";
}

async function refresh(){
  const btn=document.getElementById("refreshBtn");
  btn.disabled=true; btn.innerHTML='<span class="spin"></span> Aktualisiere …';
  let ok=0, fail=[];
  try{
    const r=await fetch(CG_URL,{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const d=await r.json();
    d.forEach(c=>{
      const a=state.assets.find(x=>x.id===c.id); if(!a) return;
      a.price=c.current_price; a.mcap=c.market_cap; a.vol=c.total_volume;
      a.ch24=c.price_change_percentage_24h;
      a.ch7=c.price_change_percentage_7d_in_currency;
      a.ch30=c.price_change_percentage_30d_in_currency;
      a.ch1y=c.price_change_percentage_1y_in_currency;
      a.ath=c.ath; a.athCh=c.ath_change_percentage;
      if(c.sparkline_in_7d&&c.sparkline_in_7d.price) a.spark=c.sparkline_in_7d.price;
      const base=YTD_BASE[a.id]; if(base) a.chYtd=(a.price-base)/base*100;
    });
    ok++;
  }catch(e){ fail.push("CoinGecko"); }

  try{
    const r=await fetch(CNBC_URL,{cache:"no-store"});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const d=await r.json();
    (d.FormattedQuoteResult.FormattedQuote||[]).forEach(it=>{
      const id=it.symbol===".SPX"?"spx":"silver";
      const a=state.assets.find(x=>x.id===id); if(!a) return;
      a.price=parseFloat(String(it.last).replace(/,/g,""));
      a.ch24=(it.change_pct&&it.change_pct!=="UNCH")?parseFloat(String(it.change_pct).replace("%","")):0;
      a.qtime=it.last_time;
      const base=YTD_BASE[id]; if(base) a.chYtd=(a.price-base)/base*100;
    });
    ok++;
  }catch(e){ fail.push("CNBC"); }

  btn.disabled=false; btn.innerHTML="↻ Jetzt aktualisieren";
  if(ok===2){ state.live=true; state.lastOk=new Date(); setStatus("on","Live verbunden · 2/2 Quellen"); }
  else if(ok===1){ state.live=true; setStatus("off","Teilweise live · "+ok+"/2 Quellen ("+fail.join(", ")+" offline)"); }
  else { state.live=false; setStatus("err","Offline · Snapshot wird angezeigt"); }
  stampNow(); render(); resetCountdown();
}

function manualRefresh(){ refresh(); }
function toggleAuto(){ state.auto=document.getElementById("autoChk").checked; resetCountdown(); }
function setInterval_(){ state.ivl=parseInt(document.getElementById("ivl").value,10); resetCountdown(); }
function setCat(c){
  state.cat=c;
  document.querySelectorAll("#catSeg button").forEach(b=>b.classList.toggle("act",b.dataset.cat===c));
  render();
}
function resetCountdown(){ state.left=state.ivl; tick(); }
function tick(){
  if(state.auto){
    state.left--;
    if(state.left<=0){ state.left=state.ivl; refresh(); return; }
    document.getElementById("countdown").textContent="Nächste Aktualisierung in "+state.left+" s";
  } else {
    document.getElementById("countdown").textContent="Auto-Refresh aus";
  }
}

/* ---------- table sort ---------- */
document.querySelectorAll("#tbl th").forEach(th=>{
  th.addEventListener("click",()=>{
    const k=th.dataset.k; if(!k) return;
    state.sort=k; document.getElementById("sortSel").value=k; render();
  });
});
document.addEventListener("keydown",e=>{ if(e.key==="Escape") closeModal(); });

/* ---------- init ---------- */
state.assets=buildAssets();
render();
setStatus("off","Snapshot geladen · verbinde …");
stampNow();
refresh();
state.cd=setInterval(tick,1000);
</script>
