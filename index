/* ---------- render ---------- */
function visible(){
  let a=state.assets.filter(x=>state.cat==="all"||x.cat===state.cat);
  if(state.q.trim()){
    const q=state.q.trim().toLowerCase();
    a=a.filter(x=>(x.name+" "+x.ticker+" "+x.id).toLowerCase().indexOf(q)>=0);
  }
  const k=state.sort;
  a.sort((x,y)=>{
    if(k==="name") return x.name.localeCompare(y.name,"de");
    if(k==="price") return (y.price||0)-(x.price||0);
    if(k==="mcap") return (y.mcap||-1)-(x.mcap||-1);
    return (y[k]==null?-1e9:y[k])-(x[k]==null?-1e9:x[k]);
  });
  return a;
}

